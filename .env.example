 # ============================================================
# Musico Server - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real values to version control.
# ============================================================


# -- Database -------------------------------------------------
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>


# -- JWT Secret -----------------------------------------------
JWT_SECRET=your_strong_jwt_secret_here


# -- Cloudinary -----------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# -- AWS S3 ---------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-2
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_CUSTOM_DOMAIN=


# -- SMTP / Email ---------------------------------------------
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password


# -- AI Services ----------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key


# -- Razorpay -------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# -- API Docs Security ----------------------------------------
DOCS_USERNAME=admin@yourdomain
DOCS_PASSWORD=your_docs_password


# -- CORS Allowed Origins (comma-separated) -------------------
CORS_ORIGINS=http://localhost:5173,https://your-production-domain.com


# -- App Frontend URL (used in email templates) ---------------
APP_FRONTEND_URL=http://localhost:5173
